# تنظیم اختیاری Cron. این فایل را به .cron.env کپی کنید.
# .cron.env وارد git نمی‌شود. فایل را با پایان‌خط LF ذخیره کنید.

# مسیر اجرایی node. اگر خالی باشد به ترتیب:
#   command -v node
#   جدیدترین فایل اجرایی /www/server/nodejs/*/bin/node
# NODE_BIN=/www/server/nodejs/v24.12.0/bin/node

# پوشه لاگ. پیش‌فرض logs/ داخل پروژه است.
# مسیر نسبی نسبت به ریشه پروژه حل می‌شود.
# LOG_DIR=logs

# لاگ‌های *.log قدیمی‌تر از این تعداد روز پاک می‌شوند. پیش‌فرض ۳۰.
# LOG_RETENTION_DAYS=30
