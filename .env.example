NODE_ENV=development
DATABASE_URL=file:./data/app.db
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CRON_SECRET=change-me-to-another-long-random-string
ADMIN_INITIAL_PASSWORD=Admin@123456
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
TZ=Asia/Tehran
# کوکی secure: true/false — اگر خالی باشد در production برابر true است
COOKIE_SECURE=
