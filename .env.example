NODE_ENV=development
DATABASE_URL=file:./data/app.db
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CRON_SECRET=change-me-to-another-long-random-string
ADMIN_INITIAL_PASSWORD=Admin@123456
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
TZ=Asia/Tehran
REALTIME_PORT=3231
INTERNAL_SECRET=change-me-to-another-long-random-string
APP_ORIGIN=http://localhost:3000
# پیش‌فرض از PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# بستهٔ apt: libheif-examples و libheif-plugin-libde265
HEIC_CONVERT_BIN=heif-convert
# بکاپ خارج از سرور خاموش است تا این مقدار پر شود. نمونه: backup@192.0.2.10:/var/backups/task-manager
# OFFSITE_BACKUP_TARGET=
# کوکی secure: true/false — اگر خالی باشد در production برابر true است
COOKIE_SECURE=
